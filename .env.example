# ---------------------------------------------------------------------------
# Harvik HR - Environment Configuration
# Copy to `.env` and replace every `change_me` / placeholder value.
# NEVER commit a real `.env`. Never hardcode secrets in source.
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
PORT=4000

# --- MongoDB (Community 7.x, single-node replica set `rs0` is required for transactions) ---
MONGO_URI=mongodb://mongo:27017/harvik_hr?replicaSet=rs0

# --- Redis 7 (queues, cache, rate limiting, session denylist) ---
REDIS_URL=redis://redis:6379

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Field-level encryption (AES-256-GCM) ---
# MUST decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=base64_32_bytes

# --- Uploads ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10

# --- Mail (leave blank to use the console/log transport) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=hr@harviktech.com

# --- Web ---
APP_BASE_URL=http://localhost:8080

# Comma-separated allow-list of permitted browser origins.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Observability ---
LOG_LEVEL=info

# Number of trusted reverse-proxy hops in front of the API. Set to 1 when nginx
# proxies /api (the docker-compose default) so rate limiting keys off the real
# client IP. Set to 0 if the API is exposed directly.
TRUST_PROXY_HOPS=1

# Backing store for the §11 rate limiters. Leave on `auto`: it resolves to
# Redis everywhere except NODE_ENV=test. `redis`/`memory` only exist so the
# suite can force one store (`npm run test:docker`, see docs/DECISIONS.md D-16).
# Forcing `redis` does not relax the 5-logins-per-minute limit.
RATE_LIMIT_STORE=auto

# --- Company / settings defaults (IANA timezone, used for date-only logic) ---
COMPANY_TIMEZONE=Asia/Kolkata
COMPANY_NAME=Harvik Technologies